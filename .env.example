# Supabase project: YOUR_PACIFICPOWER_PROJECT_REF
# Copy to .env and fill values from Supabase Dashboard > Connect.
# Never commit .env or paste database passwords into source files.
SUPABASE_PROJECT_REF=YOUR_PACIFICPOWER_PROJECT_REF
SUPABASE_URL=https://YOUR_PACIFICPOWER_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
DATABASE_URL=postgresql://postgres.YOUR_PACIFICPOWER_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
DIRECT_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PACIFICPOWER_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Supabase Storage is the primary binary object store.
# S3 access keys are server-only and must never be exposed through VITE_* variables.
SUPABASE_STORAGE_S3_ENDPOINT=https://YOUR_PACIFICPOWER_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_REGION=ap-south-1
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=YOUR_SERVER_ONLY_ACCESS_KEY_ID
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=YOUR_SERVER_ONLY_SECRET_ACCESS_KEY

# API runtime. Keep ALLOW_DEV_IDENTITY=false outside local development.
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:5173
ALLOW_DEV_IDENTITY=true

# Frontend API adapter. Empty means local JSON/localStorage mode.
VITE_API_BASE_URL=
VITE_API_ORGANIZATION_ID=
VITE_API_USER_ID=
