PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres.YOUR_PACIFICPOWER_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PACIFICPOWER_PROJECT_REF.supabase.co

# Server-only S3-compatible credentials for the private project-images bucket.
# Supabase Storage example endpoint: https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# The same variables also work with MinIO when its endpoint, region and credentials are used.
SUPABASE_STORAGE_S3_ENDPOINT=https://YOUR_PACIFICPOWER_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_REGION=ap-southeast-1
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=YOUR_SERVER_ONLY_ACCESS_KEY
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Preferred generic S3-compatible settings. Use these for MinIO; when omitted,
# the server falls back to the SUPABASE_STORAGE_S3_* variables above.
STORAGE_S3_ENDPOINT=http://127.0.0.1:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=YOUR_MINIO_ACCESS_KEY
STORAGE_S3_SECRET_ACCESS_KEY=YOUR_MINIO_SECRET_KEY
STORAGE_DOCUMENTS_BUCKET=documents

# Development only: when no identity headers are present, use the first organization.
# Keep false in staging/production; Supabase JWT middleware will provide the identity.
ALLOW_DEV_IDENTITY=true
